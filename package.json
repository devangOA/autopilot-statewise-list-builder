{
  "name": "autopilot-statewise-list-builder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Statewise list builder: discovers indoor sports court facilities and enriches them with decision-maker contacts.",
  "scripts": {
    "build:ny": "node src/index.js --state NY --out NEW_YORK_INDOOR_COURT_FACILITIES.csv",
